{
  "kind": "collectionType",
  "collectionName": "cases",
  "info": {
    "singularName": "case",
    "pluralName": "cases",
    "displayName": "Case"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "caseNumber": {
      "type": "string"
    },
    "caseType": {
      "type": "string"
    },
    "filingDate": {
      "type": "date"
    },
    "petitioner": {
      "type": "string"
    },
    "petitionerEmail": {
      "type": "email"
    },
    "petitionerPhone": {
      "type": "string"
    },
    "respondent": {
      "type": "string"
    },
    "respondentEmail": {
      "type": "email"
    },
    "respondentPhone": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "courtComplex": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "user": {
      "type": "email"
    },
    "documents": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "petitionerPic": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "respondentPic": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "stage": {
      "type": "enumeration",
      "enum": [
        "New Case",
        "Evidence Collection ",
        "In Review ",
        "Investigation in Progress ",
        "Completed"
      ]
    },
    "result": {
      "type": "enumeration",
      "enum": [
        "Case Closed – Insufficient Evidence",
        "Case Closed – Allegation Not Established",
        "Case Dismissed / Closed",
        "False Allegation Confirmed"
      ]
    },
    "findings": {
      "type": "blocks"
    },
    "isMediation": {
      "type": "boolean"
    },
    "matrimonyId": {
      "type": "string"
    },
    "matrimonySource": {
      "type": "string"
    }
  }
}
