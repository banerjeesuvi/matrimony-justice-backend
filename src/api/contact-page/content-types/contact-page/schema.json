    "whatsappUrl": { "type": "string" },
    "chambersTitle": { "type": "string" },
    "chambersSubtitle": { "type": "string" },
    "addressLabel": { "type": "string" },
    "address": { "type": "text" },
    "hoursLabel": { "type": "string" },
    "hours": { "type": "string" },
