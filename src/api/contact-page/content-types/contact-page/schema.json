      "allowedTypes": ["images"]
    },
    "charterTitle": { "type": "string" },
    "charterBody": { "type": "text" },
    "closingTitle": { "type": "string" },
    "closingBody": { "type": "text" },
    "closingPrimaryLabel": { "type": "string" },
