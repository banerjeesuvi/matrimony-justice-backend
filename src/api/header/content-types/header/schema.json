{
  "kind": "singleType",
  "collectionName": "headers",
  "info": {
    "singularName": "header",
    "pluralName": "headers",
    "displayName": "Header"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "siteName": {
      "type": "string",
      "required": true,
      "default": "Matrimony Justice"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "navLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.nav-link"
    },
    "loginLabel": {
      "type": "string",
      "default": "Login"
    },
    "loginUrl": {
      "type": "string",
      "default": "/login"
    },
    "signUpLabel": {
      "type": "string",
      "default": "Sign Up"
    },
    "signUpUrl": {
      "type": "string",
      "default": "/signup"
    }
  }
}
