{
  "kind": "collectionType",
  "collectionName": "news_tags",
  "info": {
    "singularName": "news-tag",
    "pluralName": "news-tags",
    "displayName": "News Tag"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::news-article.news-article",
      "mappedBy": "tags"
    }
  }
}
